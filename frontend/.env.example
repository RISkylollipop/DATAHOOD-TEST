# Base URL of the DATAHOOD backend API.
#
# Copy to .env (dev) or .env.production (build) — NOT optional for a
# production build. This value is inlined into the bundle at build time,
# so a missing one ships a broken app: a build with no .env.production
# once baked in localhost, and every mobile login failed with "failed to
# fetch" because on a phone `localhost` is the phone.
#
# Local dev can leave this unset — vite.config.js proxies /api to
# localhost:5000, and config.js falls back to localhost only when the page
# is actually served from localhost.
#
# Production must point at the real API host. Per DEPLOYMENT.md the API is
# a separate origin from the static frontend, so this must be absolute, and
# the FRONTEND origin must appear in the backend's CLIENT_ORIGINS or CORS
# will reject the browser.
#
#   VITE_API_URL=https://api.kwarapolydata.com.ng/api
#
# After building, verify no localhost survived:
#   grep -o "https\?://[a-zA-Z0-9.:-]*/api" build/assets/*.js | sort -u
VITE_API_URL=http://localhost:5000/api

# Legacy CRA name. Still honoured by vite.config.js as a fallback so an
# existing deploy environment keeps working, but prefer VITE_API_URL.
# REACT_APP_API_URL=http://localhost:5000/api

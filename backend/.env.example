# ============================================
#  KwaraPolyData Backend — Environment Config
#  Copy this file to `.env` and fill in real values.
#  NEVER commit the real .env to git.
# ============================================

# --- Server ---
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_ORIGINS=http://localhost:5173,https://kwarapolydata.com.ng

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kwarapo1_datahood
DB_USER=kwarapo1_datahood
DB_PASSWORD=CHANGE_ME_ROTATE_THIS_PASSWORD

# --- JWT Auth ---
# Generate a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# LEFT EMPTY ON PURPOSE. A placeholder like CHANGE_ME_LONG_RANDOM_STRING used to
# ship here, and a placeholder secret signs perfectly valid tokens — so a copied
# .env produced a working install whose signing key is published in this repo,
# meaning anyone could forge an admin session. Empty fails loudly and
# immediately instead of working insecurely.
JWT_SECRET=

# --- Session idle timeout ---
# A login expires after this many minutes of INACTIVITY, not of age: each
# request from an active session slides the window forward, so someone who
# walks away is signed out and someone mid-purchase is not.
SESSION_IDLE_MINUTES=15

# NOTE: JWT_EXPIRES_IN no longer governs login sessions. It used to, and the
# 7d shipped here quietly overrode the '15m' the signing code fell back to —
# so a copied .env gave every install week-long sessions. Session lifetime is
# SESSION_IDLE_MINUTES above and nothing else. (Short-lived tokens that are
# not sessions — the 2FA challenge, the email-change ticket — carry their own
# fixed TTLs in code, deliberately not configurable.)

# --- App encryption (AES-256 for provider/payment keys at rest) ---
# Must be 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Empty for the same reason as JWT_SECRET: a published key that "works" is worse
# than no key. Every provider and gateway secret in the database is encrypted
# with this, so a shared placeholder makes them all readable.
APP_ENCRYPTION_KEY=

# --- Admin alerts (downtime + blacklist notifications go here) ---
ADMIN_ALERT_EMAIL=youremail@example.com

# --- Email (Resend) ---
# Key from https://resend.com/api-keys
RESEND_API_KEY=re_CHANGE_ME
# MAIL_FROM must sit on a domain VERIFIED in Resend. Resend rejects any
# other sender, so this is not swappable for an arbitrary mailbox.
MAIL_FROM=support@mail.kwarapolydata.com.ng
MAIL_FROM_NAME=KwaraPolyData

# --- Web Push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@kwarapolydata.com.ng

# --- WebAuthn (Fingerprint login) ---
# rpID must be your domain (no protocol/port). Use "localhost" in dev.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=KwaraPolyData
WEBAUTHN_ORIGIN=http://localhost:5173

# --- Payment: Monnify ---
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://api.monnify.com

# --- Payment: Paystack ---
PAYSTACK_SECRET_KEY=

# --- WhatsApp receipts (choose provider in admin panel) ---
# Meta WhatsApp Cloud API
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Termii (Nigerian aggregator) — alternative
TERMII_API_KEY=
TERMII_SENDER_ID=KwaraPoly

            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gateway\": \"monnify\",\n  \"bvn\": \"22222222222\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payment/create-account",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payment",
                "create-account"
              ]
            }
          }
        },
        {
          "name": "Webhook (simulated Monnify)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "monnify-signature",
                "value": "<hmac-sha512-of-body>"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"SUCCESSFUL_TRANSACTION\",\n  \"eventData\": {\n    \"accountReference\": \"08030000001-1700000000000\",\n    \"amountPaid\": 1000,\n    \"paymentReference\": \"MNFY-TEST-001\",\n    \"paymentStatus\": \"PAID\",\n    \"paymentMethod\": \"ACCOUNT_TRANSFER\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payment/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payment",
                "webhook"
              ]
            }
          }
        },
        {
          "name": "Admin: list gateways",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/payment/gateways",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "payment",
                "gateways"
              ]
            }
          }
        },
        {
          "name": "Admin: configure gateway",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gateway\": \"monnify\",\n  \"isActive\": true,\n  \"config\": {\n    \"apiKey\": \"MK_TEST_XXXX\",\n    \"secretKey\": \"SECRET_XXXX\",\n    \"contractCode\": \"1234567890\",\n    \"baseUrl\": \"https://api.monnify.com\",\n    \"charges\": 50\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/payment/gateways",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "payment",
                "gateways"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Identity Verification",
      "item": [
        {
          "name": "List types + prices",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/verify/types",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verify",
                "types"
              ]
            }
          }
        },
        {
          "name": "Verify (NIN)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('transref', 'VER' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j=pm.response.json();",
                  "if(j.data && j.data.vId) pm.collectionVariables.set('vId', j.data.vId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"nin\",\n  \"query\": \"12345678901\",\n  \"transref\": \"{{transref}}\",\n  \"pin\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verify"
              ]
            }
          }
        },
        {
          "name": "Verification history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/verify/history?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verify",
                "history"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get single record",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/verify/{{vId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verify",
                "{{vId}}"
              ]
            }
          }
        },
        {
          "name": "Download verified slip (PDF)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/verify/{{vId}}/slip",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verify",
                "{{vId}}",
                "slip"
              ]
            }
          }
        }
      ]
    }
  ]
}
{
  "info": {
    "name": "KwaraPolyData API",
    "description": "Test collection for the Node.js backend. Set the {{baseUrl}} and {{token}} / {{adminToken}} collection variables. Auth requests auto-save tokens via test scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set('token', j.token);",
                  "pm.test('registered', () => pm.expect(j.status).to.eql('success'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"email\": \"testuser@example.com\",\n  \"phone\": \"08100000000\",\n  \"password\": \"secret123\",\n  \"state\": \"Kwara\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"08100000000\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Admin login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set('adminToken', j.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin@kwarapolydata\",\n  \"password\": \"CHANGE_ME\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/admin/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "admin",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Blacklist",
      "item": [
        {
          "name": "Submit (public/user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": \"scammer@example.com\",\n  \"reason\": \"Fraudulent activity\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/blacklist/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "blacklist",
                "submit"
              ]
            }
          }
        },
        {
          "name": "List all (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data && j.data[0]) pm.collectionVariables.set('blacklistId', j.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/blacklist?status=pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "blacklist"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            }
          }
        },
        {
          "name": "Approve (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/blacklist/{{blacklistId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "blacklist",
                "{{blacklistId}}",
                "approve"
              ]
            }
          }
        },
        {
          "name": "Reject (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/blacklist/{{blacklistId}}/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "blacklist",
                "{{blacklistId}}",
                "reject"
              ]
            }
          }
        },
        {
          "name": "Remove (admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/blacklist/{{blacklistId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "blacklist",
                "{{blacklistId}}"
              ]
            }
          }
        }
      ]
    },
